{
  "name": "docodez-plugin-template",
  "private": true,
  "version": "1.0.0",
  "description": "A minimal Docodez plugin (Vite + TypeScript): copy this folder to start your own.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node ../tools/pack.mjs dist",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
