{
  "name": "docodez-hojas",
  "private": true,
  "version": "1.0.2",
  "description": "Docodez plugin: spreadsheets (CSV, XLSX, XLS, ODS) attached to the node, using SheetJS. Built with Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node ../../tools/pack.mjs dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
